<div style="max-width:700px;margin:auto;border:1px solid #e5e7eb;padding:40px 24px;font-family:Arial,sans-serif;color:#111318;">
	<h2 style="margin:0 0 16px;font-size:24px;">Your OneClick demo request</h2>
	<p style="font-size:15px;line-height:1.6;color:#667085;">
		Hi <%= fullName %>, we received your request for a personalized OneClick demo.
	</p>
	<p style="font-size:15px;line-height:1.6;color:#667085;">
		Our team will review your workflow and contact you soon. In the meantime, you can watch our placeholder tutorial content here:
	</p>
	<a href="https://www.youtube.com/playlist?list=PLz7UO7OVllrO2oOhX1cZjR3UwdYpaBQ86" style="background:#ef2b2d;text-decoration:none;color:#fff;padding:12px 20px;margin:16px 0;display:inline-block;border-radius:4px;font-weight:700;">
		Watch on YouTube
	</a>
	<div style="margin-top:24px;padding-top:20px;border-top:1px solid #e5e7eb;">
		<p style="margin:0 0 8px;font-size:13px;color:#667085;"><strong>Name:</strong> <%= fullName %></p>
		<p style="margin:0 0 8px;font-size:13px;color:#667085;"><strong>Email:</strong> <%= email %></p>
		<p style="margin:0 0 8px;font-size:13px;color:#667085;"><strong>Company / Workshop:</strong> <%= company %></p>
		<p style="margin:0 0 8px;font-size:13px;color:#667085;"><strong>Country:</strong> <%= country %></p>
		<p style="margin:0 0 8px;font-size:13px;color:#667085;"><strong>Role:</strong> <%= role %></p>
		<% if (workflow) { %>
			<p style="margin:0;font-size:13px;line-height:1.6;color:#667085;"><strong>Workflow:</strong> <%= workflow %></p>
		<% } %>
	</div>
</div>
