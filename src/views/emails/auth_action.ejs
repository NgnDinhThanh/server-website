<div style="max-width:700px;margin:auto;border:1px solid #e5e7eb;padding:40px 24px;font-family:Arial,sans-serif;color:#111318;">
	<h2 style="margin:0 0 16px;font-size:24px;"><%= title %></h2>
	<p style="font-size:15px;line-height:1.6;color:#667085;"><%= message %></p>
	<a href="<%= url %>" style="background:#ef2b2d;text-decoration:none;color:#fff;padding:12px 20px;margin:16px 0;display:inline-block;border-radius:4px;font-weight:700;">
		<%= buttonText %>
	</a>
	<p style="font-size:13px;line-height:1.6;color:#667085;">If the button does not work, copy this link:</p>
	<div style="font-size:13px;line-height:1.6;word-break:break-all;color:#111318;"><%= url %></div>
</div>
